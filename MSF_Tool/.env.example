# Comments must be on their own line: Docker Compose treats text after an
# empty value (e.g. "KEY= #comment") as the value itself.

# Set to 1 in development to see error messages
DEBUG=0
# Generate a long, random key and keep it secret
SECRET_KEY=
# Comma-separated host names/IPs the app is served under
ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL used in the emailed survey links, e.g. https://msf.example.org
SITE_URL=

CELERY_BROKER_URL=redis://redis:6379/0

# SMTP server used for the invitation emails
EMAIL_HOST=
EMAIL_PORT=587
# Use STARTTLS (usually with port 587) or SSL (usually with port 465)
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Address the emails are sent from
DEFAULT_FROM_EMAIL=

# Comma-separated origins including the scheme, e.g. https://msf.example.org
CSRF_TRUSTED_ORIGINS=
